{
  "[markdown]": {
    "diffEditor.ignoreTrimWhitespace": true,
    "editor.defaultFormatter": "Jota0222.multi-formatter",
    "editor.formatOnSave": true,
    "editor.quickSuggestions": {
      "comments": "on",
      "other": "on",
      "strings": "on"
    },
    "editor.tabSize": 2,
    "editor.wordWrap": "off",
    "multiFormatter.formatterList": [
      "DavidAnson.vscode-markdownlint",
      "yzhang.markdown-all-in-one"
    ]
  },
  "[python-markdown]": {
    "editor.formatOnSave": true
  },
  "[toml]": {
    "editor.formatOnSave": true
  },
  "bashIde.shellcheckArguments": "--external-sources",
  "better-todo-tree.general.tags": [
    "TODO",
    "FIXME",
    "FEATURE",
    "BUG",
    "REFACTOR",
    "HACK",
    "XXX",
    "TOTEST",
    "OPTIMIZE",
    "DOCU",
    "REVIEW"
  ],
  "better-todo-tree.highlights.customHighlight": {
    "BUG": {
      "foreground": "#FF6347",
      "icon": "bug"
    },
    "DOCU": {
      "foreground": "#008B8B",
      "icon": "log"
    },
    "FEATURE": {
      "foreground": "#6495ED",
      "icon": "telescope"
    },
    "FIXME": {
      "foreground": "#B22222",
      "icon": "flame"
    },
    "HACK": {
      "foreground": "#FF7F50",
      "icon": "tools"
    },
    "OPTIMIZE": {
      "foreground": "#cd9c5c",
      "icon": "zap"
    },
    "REFACTOR": {
      "foreground": "#4682B4",
      "icon": "workflow"
    },
    "REVIEW": {
      "foreground": "#9370DB",
      "icon": "code-review"
    },
    "TODO": {
      "foreground": "#006400",
      "icon": "check-circle"
    },
    "TOTEST": {
      "foreground": "#ADD8E6",
      "icon": "beaker"
    },
    "XXX": {
      "foreground": "#FFA500",
      "icon": "alert"
    }
  },
  "better-todo-tree.highlights.defaultHighlight": {
    "background": "#1d1f23",
    "fontStyle": "italic",
    "foreground": "#006400",
    "gutterIcon": true,
    "type": "text-and-comment"
  },
  "better-todo-tree.regex.regex": "((//|#|%|<!--|;|/\\*|^|\"\"\"|'|(\\*|-)\\s\\[(\\s|x)\\])\\s*($TAGS))",
  "comment-divider.length": 80,
  "files.associations": {
    "**/docs/**/*.md": "python-markdown",
    "CONTRIBUTING.md": "markdown"
  },
  "markdown.extension.toc.levels": "2..6",
  "markdownlint.configFile": ".markdownlint.yaml"
}
